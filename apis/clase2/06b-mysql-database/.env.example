# Exercise 06b: copy this file to .env (same folder). Docker Compose and the API both read it.
# These are local development values for a database that only runs on your laptop.

# Where the API finds MySQL. Change MYSQL_PORT (for example to 3307) if 3306 is already in use.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Database and the user the API connects with (created by Docker on the first start)
MYSQL_DATABASE=library
MYSQL_USER=library
MYSQL_PASSWORD=library-pass

# Password of the MySQL root user (only used inside the container)
MYSQL_ROOT_PASSWORD=root-pass

# Port of Adminer (the web page to look at the tables). Change it if 8080 is already in use.
ADMINER_PORT=8080
